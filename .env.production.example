# ============================================================
# 生产环境配置模板（GitHub 驱动）
#
# 用法：
#   cp .env.production .env   然后替换所有 FILL_ME 占位符
#   或在 Docker/PM2/ Railway / Fly.io 等平台的环境变量中逐项注入
#
# ⚠️ 本文件是模板，只有占位符，可安全入库。
#    填好真实值后另存为 .env（该文件名已被 .gitignore 全量拦截）
#
# ⚠️ 前置条件：GITHUB_TOKEN 必须是 fine-grained token，
#    且仅授权 gh-jsdelivr-imagebed 这一个仓库的 Contents: Read and write。
#    不要用classic token（repo 权限覆盖全账号，泄露面过大）。
# ============================================================

# ---------- 运行环境 ----------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# 前面有 Nginx/Caddy 一层则填 1。填错会让限流把所有请求算作同一 IP
TRUST_PROXY_HOPS=1

# ---------- 存储驱动 ----------
# github = 仓库即存储，生产唯一正确取值
STORAGE_DRIVER=github

# ---------- GitHub 仓库配置 ----------
# Token 生成路径（务必 fine-grained）：
#   GitHub → Settings → Developer settings → Personal access tokens
#   → Generate new token (fine-grained)
#   → Repository access: Only select repositories → 勾选 gh-jsdelivr-imagebed
#   → Permissions → Repository permissions → Contents: Read and write
#   → Generate token
#
# ⚠️ 该 token 等同于图床仓库的写权限。泄露即可被任意篡改仓库内容。
#    不要复用本机开发用的 token，那是全账号权限。
GITHUB_TOKEN=FILL_ME_fine_grained_token_single_repo

# 仓库所有者与仓库名，与 CDN 地址中的必须一致
GITHUB_OWNER=HoengFung
GITHUB_REPO=gh-jsdelivr-imagebed
GITHUB_BRANCH=main

# 图片在仓库中的根目录（对应 PicGo 的「存储路径」）
GITHUB_PATH_PREFIX=img

# 高级项，通常无需修改
GITHUB_API_BASE=https://api.github.com
GITHUB_TIMEOUT_MS=30000
GITHUB_MAX_RETRIES=3

# ---------- CDN 配置 ----------
# 已填真实值：validate() 会拒绝含 CHANGE_ME 的配置
CDN_BASE_URL=https://cdn.jsdelivr.net/gh/HoengFung/gh-jsdelivr-imagebed@main
# 国内镜像回退，jsDelivr 官方源不稳定时自动切换
CDN_MIRRORS=https://cdn.jsdmirror.com/gh,https://fastly.jsdelivr.net/gh
# 接入自有域名（Cloudflare / 又拍云）时填写，会覆盖 CDN_BASE_URL
CDN_CUSTOM_DOMAIN=

# ---------- 上传限制 ----------
# 默认 5MB。jsDelivr 单文件硬限制 20MB，不要调高
MAX_FILE_SIZE=5242880
MAX_FILES=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,avif,bmp,svg,ico
ALLOWED_MIME=image/jpeg,image/png,image/gif,image/webp,image/avif,image/bmp,image/svg+xml,image/x-icon
# SVG 可内联 <script>，保持false。开启需先在 CDN 前加 WAF 规则
ALLOW_SVG=false
# hash = 内容寻址（推荐）：同一张图重复上传得到同一 URL，CDN 命中率接近 100%
NAMING_STRATEGY=hash

# ---------- 访问控制 ----------
# proxy = 本服务回源转发，防盗链与鉴权真正生效。
# 注意：jsDelivr 直链本身是公开的，proxy 模式不代表 CDN 侧也受保护。
ACCESS_MODE=proxy

# ---------- 鉴权 ----------
REQUIRE_AUTH=true
# 上传 Token。生成：openssl rand -hex 32
# 可用逗号分隔配置多个，便于多端隔离与轮换
UPLOAD_TOKENS=FILL_ME_run_openssl_rand_hex_32
# 禁止通过 ?token= 传凭证（会进访问日志与浏览器历史）
ALLOW_QUERY_TOKEN=false

# 读取鉴权：是否要求图片访问带签名参数
# 仅对本站代理路径 /i/ 生效，jsDelivr 直链无法约束
REQUIRE_SIGNED_URL=false
# REQUIRE_SIGNED_URL=true 时必填，生成：openssl rand -hex 32
URL_SIGNING_SECRET=
URL_TTL_SECONDS=3600

# ---------- 防盗链 ----------
# 仅在自己站点内使用时填写域名；留空表示该维度不启用
# 支持 *.example.com 通配
ALLOWED_REFERERS=
ALLOWED_ORIGINS=
# 图片只在自己站点内使用时建议改 false，堵掉直链盗刷
ALLOW_EMPTY_REFERER=true
# 在代理路径上真正拦截外链（jsDelivr 直链无法拦截）
BLOCK_DIRECT_HOTLINK=true

# ---------- 限流 ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300

# ---------- CORS ----------
# 图床通常需被任意站点引用。仅自用时收紧为自己的域名：
# CORS_ORIGINS=https://blog.example.com
CORS_ORIGINS=*
CORS_CREDENTIALS=false

# ---------- 其他 ----------
# 远程URL 转存含 SSRF 风险，保持关闭
ENABLE_URL_FETCH=false

# ---------- 部署备注 ----------
# Dockerfile 已用多阶段构建，.env 不要打进镜像，走运行时注入。
# 本地驱动专用项（local 驱动时才有意义，github 驱动下可忽略）：
#   LOCAL_STORAGE_DIR=storage/local
