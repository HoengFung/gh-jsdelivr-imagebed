# ==========================================================================
# 图床服务环境变量模板
#
# 使用方法：
#   cp .env.example .env   然后把占位符替换为真实值
#
# ⚠️ 安全约定：
#   - .env 已被 .gitignore 排除，切勿提交到版本库
#   - 本文件中所有 CHANGE_ME / your_xxx 均为占位符，必须替换后才能启动
#   - 生产环境建议由部署平台（Railway / Fly.io / K8s / systemd）的密钥管理注入，
#     不要把.env 打进镜像
# ==========================================================================

# ---------- 运行环境 ----------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# 反向代理层数：Nginx/Caddy 在一层则填 1。不设置会导致限流把所有请求算作同一个 IP
TRUST_PROXY_HOPS=1

# ---------- 存储驱动 ----------
# github = GitHub 仓库即存储（对应文章方案，生产用这个）
# local  = 本地磁盘（离线调试 / CI 用）
STORAGE_DRIVER=github

# ---------- GitHub 仓库配置（存储驱动的核心）----------
# Token 生成路径：GitHub → Settings → Developer settings → Personal access tokens
#   → Generate new token (classic) →勾选 repo 权限
# Fine-grained token 也可，但需对该仓库授予 Contents: Read and write
#
# ⚠️ Token 等同于仓库写权限，泄露即可被任意篡改仓库内容。
#    务必用 fine-grained token 并限定到单个仓库，不要用全账号权限的 classic token。
GITHUB_TOKEN=ghp_CHANGE_ME_your_personal_access_token

# 仓库所有者（用户名或组织名）与仓库名
GITHUB_OWNER=CHANGE_ME
GITHUB_REPO=CHANGE_ME

# 分支。GitHub 新建仓库默认是 main；老仓库可能是 master
GITHUB_BRANCH=main

# 图片在仓库中的根目录，对应 PicGo 的「存储路径」
GITHUB_PATH_PREFIX=img

# 高级项，通常无需修改
GITHUB_API_BASE=https://api.github.com
GITHUB_TIMEOUT_MS=30000
GITHUB_MAX_RETRIES=3

# ---------- CDN 配置 ----------
# 对应 PicGo 的「自定义域名」，格式：https://cdn.jsdelivr.net/gh/<owner>/<repo>@<branch>
CDN_BASE_URL=https://cdn.jsdelivr.net/gh/CHANGE_ME/CHANGE_ME@main

# 国内镜像源，逗号分隔，按顺序回退。留空则只用官方源
CDN_MIRRORS=https://cdn.jsdmirror.com/gh,https://fastly.jsdelivr.net/gh

# 若已接入自有域名（Cloudflare / 又拍云等），填这里会覆盖 CDN_BASE_URL
CDN_CUSTOM_DOMAIN=

# ---------- 上传限制 ----------
# 单文件大小上限（字节）。默认 5MB。
# 上限参考：jsDelivr 单文件硬限制 20MB，GitHub Contents API 单文件 50MB（base64 后膨胀 1/3）
MAX_FILE_SIZE=5242880
MAX_FILES=10
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,avif,bmp,svg,ico
ALLOWED_MIME=image/jpeg,image/png,image/gif,image/webp,image/avif,image/bmp,image/svg+xml,image/x-icon

# SVG 可内联 <script>，默认禁止。开启前务必在前置 WAF 加规则
ALLOW_SVG=false

# 文件命名策略：hash（内容寻址，推荐）/ original（保留原名）/ timestamp
NAMING_STRATEGY=hash

# ---------- 访问控制 ----------
# proxy   = 本服务回源转发（防盗链/鉴权真正生效，默认）
# redirect= 302 跳转到 CDN（快，但用户可见真实 CDN 域名）
# public  = 直接返回 CDN 链接，不经本服务
ACCESS_MODE=proxy

# ---------- 鉴权 ----------
# 是否强制上传鉴权。生产环境必须为 true
REQUIRE_AUTH=true

# 上传 Token，逗号分隔可配置多个（多端/多环境隔离与轮换用）。
# ⚠️ 这是明文，请用足够长的随机串：openssl rand -hex 32
UPLOAD_TOKENS=CHANGE_ME_please_generate_a_random_token

# 是否允许通过 ?token= 传凭证。默认不允许（会进访问日志与浏览器历史）
ALLOW_QUERY_TOKEN=false

# 读取鉴权：是否要求图片访问带签名参数。
# 注意：仅对本站代理路径 /i/ 生效；jsDelivr 直链本身是公开的
REQUIRE_SIGNED_URL=false
URL_SIGNING_SECRET=
URL_TTL_SECONDS=3600

# ---------- 防盗链 ----------
# Referer 白名单，逗号分隔。支持 *.example.com 通配。
# 留空表示该维度不启用
ALLOWED_REFERERS=
# Origin 白名单（跨域场景更可靠），逗号分隔
ALLOWED_ORIGINS=
# 是否放行无 Referer 的请求（图片直链、Typora 粘贴、微信内置浏览器常见）
# 若图片只在自己站点内使用，建议设为 false
ALLOW_EMPTY_REFERER=true
# 是否在代理路径上真正拦截外链
BLOCK_DIRECT_HOTLINK=true

# ---------- 限流 ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=30
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=300

# ---------- CORS ----------
# 图床通常需要被任意站点引用，默认放开。
# 若仅自用，填自己的域名收紧：CORS_ORIGINS=https://blog.example.com
CORS_ORIGINS=*
CORS_CREDENTIALS=false

# ---------- 其他 ----------
# 是否允许通过 /api/v1/url 转存远程图片（默认关闭，含 SSRF 风险）
ENABLE_URL_FETCH=false

# 本地驱动专用
LOCAL_STORAGE_DIR=storage/local